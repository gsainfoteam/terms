{{ $serviceName := .Section -}}
{{ $serviceData := dict -}}
{{ range .Pages -}}
  {{ $type := index (strings.Split .Path "/" | last 2) 0 -}}
  {{ $version := index (strings.Split .Path "/" | last 1) 0 | int -}}
  {{ $cachedPage := index $serviceData $type -}}
  {{ $data := dict "version" $version "date" .Date -}}
  {{ if $cachedPage -}}
    {{ if ge .Date (index $cachedPage "date") -}}
      {{ $serviceData = merge $serviceData (dict $type $data) -}}
    {{ end -}}
  {{ else if not .Draft -}}
    {{ $serviceData = merge $serviceData (dict $type $data) -}}
  {{ end -}}
{{ end -}}
{
  "service": {{ $serviceName | jsonify }},
  "privacy": {{ index (index $serviceData "privacy") "version" | jsonify }},
  "tos": {{ index (index $serviceData "tos") "version" | jsonify }}
}