{{ $serviceName := .Section -}}
{{ $serviceData := dict -}}
{{ range .Pages -}}
  {{ $type := index (strings.Split .Path "/" | last 2) 0 -}}
  {{ $version := index (strings.Split .Path "/" | last 1) 0 | int -}}
  {{ $cachedPage := index $serviceData $type -}}
  {{ if $cachedPage -}}
    {{ if ge .Date $cachedPage.Date -}}
      {{ $serviceData = merge $serviceData (dict $type $version) -}}
    {{ end -}}
  {{ else if not .Draft - }}
    {{ $serviceData = merge $serviceData (dict $type $version) -}}
  {{ end -}}
{{ end -}}
{
  "service": {{ $serviceName | jsonify }},
  "privacy": {{ index $serviceData "privacy" | jsonify }},
  "tos": {{ index $serviceData "tos" | jsonify }}
}